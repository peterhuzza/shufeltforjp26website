# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js Build Output
/.next/
/out/

# Production Build
/build

# Docker Specific
.dockerignore
# (Note: Don't ignore the file itself, but ignore these if they are generated)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
# Always ignore the actual production secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore .env.example as it serves as a template for others
!.env.example

# Debugging and Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage
/.nyc_output

# Vercel
.vercel

# System Files
.DS_Store
*.pem
